      "n": "Lobby",
      "p": {
       "Source": "-- ServerScriptService.Lobby: the hotel's lobby. Step into the elevator: once someone is in,\n-- it counts down and takes everyone inside (up to six) into the hotel together, on a\n-- server of their own. Coins, the best door and escapes are saved (DataStore \"Hotel\",\n-- the hotel adds to them) and shown on the board and over your head.\nlocal Players = game:GetService(\"Players\")\nlocal TeleportService = game:GetService(\"TeleportService\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal RS = game.ReplicatedStorage\nlocal Shared = require(RS.Shared)\nlocal Store = game:GetService(\"DataStoreService\"):GetDataStore(\"Hotel\")\n\nlocal HOTEL = RS.Config.HotelPlaceId.Value\nlocal zone = workspace.Elevator.Zone\nlocal doorL = workspace.Elevator.DoorL\nlocal doorR = workspace.Elevator.DoorR\nlocal sign = workspace.Elevator.Sign\nlocal Countdown = RS.Countdown\n\nlocal openL, openR = doorL.Position, doorR.Position\nlocal shutL = openL + Vector3.new(2, 0, 0)\nlocal shutR = openR - Vector3.new(2, 0, 0)\n\nlocal function rootOf(player)\n\tlocal c = player.Character\n\treturn c and c:FindFirstChild(\"HumanoidRootPart\")\nend\n\nlocal function stat(parent, name, value)\n\tlocal v = Instance.new(\"IntValue\")\n\tv.Name = name\n\tv.Value = value\n\tv.Parent = parent\n\treturn v\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tlocal ok, data = pcall(function()\n\t\treturn Store:GetAsync(Shared.key(player))\n\tend)\n\tdata = ok and type(data) == \"table\" and data or Shared.blank()\n\tlocal ls = Instance.new(\"Folder\")\n\tls.Name = \"leaderstats\"\n\tls.Parent = player\n\tstat(ls, \"Coins\", data.coins or 0)\n\tstat(ls, \"Best\", data.best or 0)\n\tstat(ls, \"Escapes\", data.escapes or 0)\n\t-- Back from the hotel: how it went (the lobby screen says it).\n\tlocal j = player:GetJoinData().TeleportData\n\tif type(j) == \"table\" then\n\t\ttask.delay(1.5, function()\n\t\t\tRS.Result:FireClient(player, j.escaped == true, tonumber(j.door) or 0)\n\t\tend)\n\tend\nend)\n\nlocal function inside()\n\tlocal list = {}\n\tlocal c, s = zone.Position, zone.Size / 2\n\tfor _, player in Players:GetPlayers() do\n\t\tlocal root = rootOf(player)\n\t\tif root then\n\t\t\tlocal p = root.Position - c\n\t\t\tif math.abs(p.X) <= s.X and math.abs(p.Z) <= s.Z and p.Y > -s.Y - 2 and p.Y < s.Y + 4 then\n\t\t\t\ttable.insert(list, player)\n\t\t\tend\n\t\tend\n\t\tif #list >= Shared.MAX_PARTY then\n\t\t\tbreak\n\t\tend\n\tend\n\treturn list\nend\n\nlocal function doors(shut)\n\tlocal t = TweenInfo.new(0.8, \"Quad\", \"InOut\")\n\tTweenService:Create(doorL, t, { Position = shut and shutL or openL }):Play()\n\tTweenService:Create(doorR, t, { Position = shut and shutR or openR }):Play()\nend\n\n-- The elevator: waits for riders, counts down, goes.\nlocal left = 0\nwhile true do\n\ttask.wait(1)\n\tlocal riders = inside()\n\tif #riders == 0 then\n\t\tleft = 0\n\t\tCountdown.Value = -1\n\t\tsign.Text = \"\"\n\telse\n\t\tif left <= 0 then\n\t\t\tleft = 12\n\t\tend\n\t\tleft -= 1\n\t\tCountdown.Value = left\n\t\t-- (numbers only: the sign reads the same in every language)\n\t\tsign.Text = string.format(\"%d   ·   %d/%d\", left, #riders, Shared.MAX_PARTY)\n\t\tif left <= 0 then\n\t\t\tdoors(true)\n\t\t\tsign.Text = \"▲\"\n\t\t\ttask.wait(1.2)\n\t\t\triders = inside()\n\t\t\tif #riders > 0 and HOTEL ~= \"\" then\n\t\t\t\tTeleportService:TeleportPartyAsync(HOTEL, riders, { party = #riders })\n\t\t\tend\n\t\t\ttask.wait(3)\n\t\t\tdoors(false)\n\t\t\tleft = 0\n\t\tend\n\tend\nend\n"
      }
     }
    ]
   },
   {
    "c": "ServerStorage",
    "n": "ServerStorage"
   },
   {
    "c": "StarterGui",
    "n": "StarterGui"
   },
   {
    "c": "StarterPlayer",
    "n": "StarterPlayer",
    "p": {
     "CameraMaxZoom": 14
    },
    "k": [
     {
      "c": "StarterPlayerScripts",
      "n": "StarterPlayerScripts",
      "k": [
       {
        "c": "LocalScript",
        "n": "LobbyUI",
        "p": {
         "Source": "-- StarterPlayerScripts.LobbyUI: your coins, best door and escapes; how the last trip went.\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal RS = game.ReplicatedStorage\nlocal Shared = require(RS.Shared)\n\nlocal me = Players.LocalPlayer\nlocal gui = Instance.new(\"ScreenGui\")\ngui.Name = \"LobbyUI\"\ngui.Parent = me:WaitForChild(\"PlayerGui\")\n\nlocal card = Instance.new(\"Frame\")\ncard.Size = UDim2.new(0, 230, 0, 96)\ncard.Position = UDim2.new(1, -246, 0, 70)\ncard.BackgroundColor = Color3.fromHex(\"#16141d\")\ncard.BackgroundTransparency = 0.3\ncard.Parent = gui\nlocal corner = Instance.new(\"UICorner\")\ncorner.CornerRadius = 14\ncorner.Parent = card\n\nlocal function line(y, color)\n\tlocal l = Instance.new(\"TextLabel\")\n\tl.Size = UDim2.new(1, -24, 0, 26)\n\tl.Position = UDim2.new(0, 12, 0, y)\n\tl.BackgroundTransparency = 1\n\tl.TextColor = color\n\tl.TextSize = 18\n\tl.Font = \"Bold\"\n\tl.TextXAlignment = \"Left\"\n\tl.Parent = card\n\treturn l\nend\nlocal coins = line(8, Color3.fromHex(\"#ffd36b\"))\nlocal best = line(36, Color3.fromHex(\"#f4f1ec\"))\nlocal escapes = line(62, Color3.fromHex(\"#9cffb0\"))\n\ntask.spawn(function()\n\tlocal ls = me:WaitForChild(\"leaderstats\")\n\tlocal function show()\n\t\tcoins.Text = Strings.get(\"lobby_coins\", ls.Coins.Value)\n\t\tbest.Text = Strings.get(\"lobby_best\", Shared.door(ls.Best.Value))\n\t\tescapes.Text = Strings.get(\"lobby_escapes\", ls.Escapes.Value)\n\tend\n\tfor _, k in { \"Coins\", \"Best\", \"Escapes\" } do\n\t\tls:WaitForChild(k).Changed:Connect(show)\n\tend\n\tshow()\nend)\n\n-- How the last trip went, for a few seconds.\nRS.Result.OnClientEvent:Connect(function(escaped, door)\n\tlocal l = Instance.new(\"TextLabel\")\n\tl.Size = UDim2.new(0, 640, 0, 50)\n\tl.Position = UDim2.new(0.5, -320, 0, 110)\n\tl.BackgroundTransparency = 1\n\tl.TextColor = escaped and Color3.fromHex(\"#9cffb0\") or Color3.fromHex(\"#8fd0ff\")\n\tl.TextSize = 28\n\tl.Font = \"Black\"\n\tl.TextWrapped = true\n\tl.Text = escaped and Strings.get(\"result_escaped\") or Strings.get(\"result_died\", Shared.door(door))\n\tl.Parent = gui\n\ttask.wait(6)\n\tTweenService:Create(l, TweenInfo.new(1), { TextTransparency = 1 }):Play()\n\ttask.wait(1)\n\tl:Destroy()\nend)\n"
        }
       }
      ]
     }
    ]
   },
   {
    "c": "StarterPack",
    "n": "StarterPack"
   }
  ]
 }
}