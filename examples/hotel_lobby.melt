{
 "format": "melt",
 "version": 1,
 "meta": {
  "name": "Midnight Hotel",
  "description": "A hotel of 100 doors. Find the keys, hide from the Howl when the lights flicker, outrun the Watcher. Play with up to 6 friends: the elevator takes you in together.",
  "i18n": {
   "name": {
    "ru": "Отель «Полночь»"
   },
   "description": {
    "ru": "Отель из 100 дверей. Ищи ключи, прячься от Вопля, когда мигает свет, убегай от Следящего. Играй с друзьями, до 6 человек: лифт увозит вас вместе."
   }
  }
 },
 "strings": {
  "title": {
   "en": "MIDNIGHT HOTEL",
   "ru": "ОТЕЛЬ «ПОЛНОЧЬ»"
  },
  "elevator": {
   "en": "ELEVATOR",
   "ru": "ЛИФТ"
  },
  "lobby_hint": {
   "en": "Step into the elevator with your friends: it takes up to 6 of you into the hotel. Get through 100 doors. Hide when the lights flicker. Run when the eyes look at you.",
   "ru": "Заходи в лифт с друзьями: он увозит в отель до 6 человек. Пройди 100 дверей. Прячься, когда мигает свет. Беги, когда на тебя смотрят глаза."
  },
  "lobby_coins": {
   "en": "Coins: {0}",
   "ru": "Монеты: {0}"
  },
  "lobby_best": {
   "en": "Best door: {0}",
   "ru": "Лучшая дверь: {0}"
  },
  "lobby_escapes": {
   "en": "Escaped: {0}",
   "ru": "Выбрался: {0}"
  },
  "result_died": {
   "en": "You fell at door {0}. Try again!",
   "ru": "Ты пал у двери {0}. Попробуй ещё раз!"
  },
  "result_escaped": {
   "en": "You got out of the hotel! +30 coins",
   "ru": "Ты выбрался из отеля! +30 монет"
  },
  "welcome": {
   "en": "WELCOME, GUEST",
   "ru": "ДОБРО ПОЖАЛОВАТЬ, ГОСТЬ"
  },
  "way_out": {
   "en": "WAY OUT",
   "ru": "ВЫХОД"
  },
  "door_n": {
   "en": "Door {0}",
   "ru": "Дверь {0}"
  },
  "coins_run": {
   "en": "Coins: {0}",
   "ru": "Монеты: {0}"
  },
  "hide": {
   "en": "Hide",
   "ru": "Спрятаться"
  },
  "leave": {
   "en": "Get out",
   "ru": "Выйти"
  },
  "wardrobe": {
   "en": "Wardrobe",
   "ru": "Шкаф"
  },
  "open": {
   "en": "Open",
   "ru": "Открыть"
  },
  "drawer": {
   "en": "Drawer",
   "ru": "Ящик"
  },
  "take": {
   "en": "Take",
   "ru": "Взять"
  },
  "key": {
   "en": "Key",
   "ru": "Ключ"
  },
  "unlock": {
   "en": "Unlock",
   "ru": "Отпереть"
  },
  "locked_door": {
   "en": "Locked door",
   "ru": "Запертая дверь"
  },
  "got_coins": {
   "en": "+{0} coins",
   "ru": "+{0} монет"
  },
  "empty": {
   "en": "Empty...",
   "ru": "Пусто..."
  },
  "got_key": {
   "en": "The key to door {0}",
   "ru": "Ключ от двери {0}"
  },
  "need_key": {
   "en": "Locked. The key is somewhere in this room",
   "ru": "Заперто. Ключ где-то в этой комнате"
  },
  "died_howl": {
   "en": "You died to the Howl...",
   "ru": "Тебя забрал Вопль..."
  },
  "advice_howl": {
   "en": "When the lights flicker and the walls rumble, it's coming. Hide in a wardrobe, quick!",
   "ru": "Когда мигает свет и гудят стены, он уже летит. Скорее прячься в шкаф!"
  },
  "died_watcher": {
   "en": "You died to the Watcher...",
   "ru": "Тебя поймал Следящий..."
  },
  "advice_watcher": {
   "en": "Eyes on the walls mean it's near. When it comes, don't look back: sprint and keep running.",
   "ru": "Глаза на стенах значат, что он рядом. Когда появится, не оборачивайся: зажми бег и беги не останавливаясь."
  },
  "died_fall": {
   "en": "You died...",
   "ru": "Ты погиб..."
  },
  "advice_fall": {
   "en": "The hotel doesn't let go easily. Try again, and stay together.",
   "ru": "Отель так просто не отпускает. Попробуй ещё, и держитесь вместе."
  },
  "back_to_lobby": {
   "en": "Back to the lobby...",
   "ru": "Возвращаемся в лобби..."
  },
  "escaped": {
   "en": "You got out!",
   "ru": "Ты выбрался!"
  },
  "escaped_sub": {
   "en": "100 doors behind you. +30 coins",
   "ru": "Позади 100 дверей. +30 монет"
  },
  "reception": {
   "en": "RECEPTION",
   "ru": "РЕСЕПШН"
  }
 },
